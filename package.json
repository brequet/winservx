{
	"name": "winservx",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "svelte-check --tsconfig ./tsconfig.json && tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"validate": "pnpm run check && pnpm run lint"
	},
	"dependencies": {
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"svelte": "^5.56.8"
	},
	"devDependencies": {
		"@eslint/css": "^1.4.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tauri-apps/cli": "^2",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.5",
		"svelte-eslint-parser": "^1.8.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1"
	}
}
