{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "WinServX",
	"version": "0.1.0",
	"identifier": "fr.requet.winservx",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "WinServX",
				"width": 1100,
				"height": 720,
				"minWidth": 1060,
				"minHeight": 560
			}
		],
		"security": {
			"csp": "default-src 'self' ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["msi", "nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico"
		]
	}
}
